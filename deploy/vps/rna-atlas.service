[Unit]
Description=Aedes RNA Atlas (Streamlit)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/rna-atlas/app
Environment=RNA_ATLAS_PUBLIC=1
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/rna-venv/bin/streamlit run app.py \
    --server.address 127.0.0.1 \
    --server.port 8501 \
    --server.headless true \
    --browser.gatherUsageStats false
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
